# Supabase 公開クライアント用（ブラウザに露出してよい値。RLS で保護される）
# 実値は Supabase ダッシュボード or `supabase` MCP の get_project_url / get_publishable_keys から取得し
# .env.local（gitignore 済み）に設定する。
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# 管理パネルのサーバ側書き込み・管理の読み取り・画像アップロード用（秘密。ブラウザに出さない）。
# RLS をバイパスするため server-only でのみ使用する（docs/11・12）。
# 実値は Supabase ダッシュボード → Settings → API Keys → Secret key（`sb_secret_...`）から取得。
# （publishable key とは別物。旧 UI の service_role JWT でも可）
SUPABASE_SERVICE_ROLE_KEY=

# 管理パネル認証（docs/11）。パスワード + httpOnly cookie 方式。いずれもサーバー限定。
# ADMIN_PASSWORD: 管理パネルのログインパスワード（タイミングセーフに比較される）
# ADMIN_SESSION_SECRET: セッション cookie の HMAC 署名鍵。32 文字以上のランダム文字列を推奨
#   （例: `openssl rand -hex 32` で生成）。変更すると既存セッションは無効になる。
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# AI 英訳下訳生成用（docs/13）。秘密・サーバー限定。Google AI Studio
# （https://aistudio.google.com/apikey）で取得。未設定だと「英訳生成」ボタンがエラーを返す。
GEMINI_API_KEY=

# SEO / AIO（docs/14・16）。canonical・hreflang・sitemap・JSON-LD・OGP 画像の絶対 URL に使う。
#
# NEXT_PUBLIC_SITE_URL:
#   **Vercel では設定しない。** 未設定なら Vercel のドメイン（preview は VERCEL_URL、
#   本番は VERCEL_PROJECT_PRODUCTION_URL）を自動で使う。独自ドメインを取ったときだけ設定する。
#   ローカル開発では http://localhost:3000 を入れる（末尾スラッシュは付けない）。
#   ※ 実在しないドメインを既定値に置かない。canonical も sitemap も og:image もこの値を基点にする。
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 公開フェーズ。'preview'（交渉中・全ページ noindex + robots 全拒否）/ 'public'（本公開）。
# 既定は preview（安全側）。NEXT_PUBLIC のためビルド時に固定＝切替は再デプロイが必要。
# **Vercel の Preview 環境とは別物**。交渉中は Vercel の Production でも preview のままにする。
NEXT_PUBLIC_SITE_PHASE=preview
# 任意: Google Search Console のサイト所有権メタタグの値（token 部分のみ）。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Vercel Cron から Supabase keepalive（/api/cron/keepalive）を叩くときの共有シークレット（docs/16）。
# 秘密・サーバー限定。Vercel に設定しておくと Cron 実行時に Authorization: Bearer <値> が自動で付く。
# 16 文字以上のランダム文字列（例: `openssl rand -hex 32`）。未設定だとエンドポイントが 500 を返す。
# ローカルでは keepalive を叩かないので空のままでよい。
CRON_SECRET=
